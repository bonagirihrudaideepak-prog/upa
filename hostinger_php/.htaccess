DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Enable CORS headers
    <IfModule mod_headers.c>
        Header set Access-Control-Allow-Origin "*"
        Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
    </IfModule>

    # Handle OPTIONS preflight requests
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ $1 [R=200,L]

    # Route /api and /api/* requests to index.php
    RewriteRule ^api(/.*)?$ index.php [QSA,L]

    # Serve uploaded files directly
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^uploads/ - [L]

    # Fallback to SPA index.html for non-API frontend routes
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/api
    RewriteRule ^ index.html [QSA,L]
</IfModule>

# ========================================================
# Harden the uploads directory
# ========================================================
<DirectoryMatch "^.*/uploads(/|$)">
    # Never execute PHP (or any server-side scripts) from user uploads
    <IfModule mod_php.c>
        php_flag engine off
    </IfModule>
    <FilesMatch "\.(php|phtml|php3|php4|php5|php7|phar|pl|py|cgi|sh)$">
        Require all denied
    </FilesMatch>
    # Force browsers to respect the served content type (prevents MIME-sniffing)
    <IfModule mod_headers.c>
        Header set X-Content-Type-Options "nosniff"
    </IfModule>
</DirectoryMatch>
